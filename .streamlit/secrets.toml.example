# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Community Cloud
# -> App settings -> Secrets. Presence of [snowflake] switches the app to LIVE MODE.
# NEVER commit the real file.

[snowflake]
account   = "xy12345.ap-south-1.aws"   # your account identifier
user      = "POLICYPULSE_APP"
password  = "********"                 # or use private_key_file / authenticator
role      = "POLICYPULSE_ROLE"
warehouse = "POLICYPULSE_WH"
database  = "POLICYPULSE"
schema    = "APP"
